DOMAIN=example.workbright-qa.dev
EMAIL=test-account@workbright.com
PASSWORD=test-password
# Secret matched by the Cloudflare WAF "Skip" custom rule to bypass the bot check.
# Generate with: openssl rand -hex 32
CF_BYPASS_TOKEN=

# Production runs (`npm run qa:verify -- --prod`, opt-in per manifest entry).
# Use a DEDICATED production test account — specs sign in and modify account data.
# Leave these empty to keep production runs impossible. Prod runs send the same
# CF_BYPASS_TOKEN header above, so production's WAF skip rule must match it.
PROD_DOMAIN=
PROD_EMAIL=
PROD_PASSWORD=

# Anthropic API key for the headless Claude agent (or set CLAUDE_CODE_OAUTH_TOKEN instead)
ANTHROPIC_API_KEY=

# Run: docker compose -f docker-compose.agent.yml run --rm -it --entrypoint claude qa-agent setup-token
# Gives code to paste back into the terminal
# Provide Code Below
CLAUDE_CODE_OAUTH_TOKEN=

# Asana personal access token: app.asana.com -> Settings -> Apps -> Developer apps -> PAT
ASANA_TOKEN=

# Optional overrides:
# QA_PROJECT_GID=1212777014402169   # Asana project to sweep (default: Engineering Lifecycle)
# QA_SECTION_NAME=QA                # sweep this section (default)
# QA_TAG_NAME=Test                  # sweep by tag instead of section
# CLAUDE_MODEL=                     # override the agent model (defaults to Claude Code's default)
